# Core Server & Database
PORT=5000
DB_URL=mongodb://localhost:27017/asia-lms
NODE_ENV=development

# Authentication & Security
AUTH_API_KEY=aHR0cHM6Ly9kYXRhLWthcHBhLnZlcmNlbC5hcHAv
JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_REFRESH_EXPIRES=7d
EXPRESS_SESSION_SECRET=your_express_session_secret
BCRYPT_SALT_ROUND=10

# Initial Super Admin Credentials
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=securepassword123

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# SSLCommerz Payment Gateway
STORE_ID=study69fb90eccfaf0
STORE_PASS=study69fb90eccfaf0@ssl
IS_LOCALHOST=true

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Server
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="LMS App <noreply@yourdomain.com>"

# Redis Caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
